# Copy to .env and fill in (never commit .env)
# Clerk demo sign-in (use keys from the same Development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
XAI_API_KEY=
CLAUDE_API_KEY=
CLAUDE_API_KEY_2=
EXA_API_KEY=
ELEVENLABS_API_KEY=
# Optional creative/backend database overrides (defaults shown)
STDB_URL=https://maincloud.spacetimedb.com
STDB_DATABASE=ripple-mhacks
# Optional: host the Fetch.ai button images at another public HTTPS base URL.
RIPPLE_CARD_ASSET_URL=
# X (Twitter) API v2 — from https://developer.x.com
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
## Optional local scraper budget; X server rate limits still apply.
SCWEET_DAILY_REQUESTS_LIMIT=300
